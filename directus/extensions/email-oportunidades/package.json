{
  "name": "email-oportunidades",
  "version": "1.0.0",
  "description": "Lê a caixa comercial (IMAP / Office 365), interpreta pedidos de orçamento com Claude e cria oportunidades no Directus",
  "type": "module",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-bundle",
    "email-oportunidades"
  ],
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "endpoint",
        "name": "email-oportunidades",
        "source": "src/endpoint/index.ts"
      },
      {
        "type": "hook",
        "name": "email-oportunidades-poll",
        "source": "src/hook/index.ts"
      }
    ],
    "host": "^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "type-check": "tsc --noEmit",
    "test:fixtures": "tsx scripts/test-fixtures.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "imapflow": "^1.0.190",
    "ioredis": "^5.6.1",
    "mailparser": "^3.7.4",
    "xlsx": "^0.18.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^13.0.0",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
