# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.DS_Store
dist
dist-ssr
coverage
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*.tsbuildinfo

# Env (keep .env.example)
.env
.env.local
.env.*.local
.env.production
!.env.production.example

# Directus runtime data
directus/uploads/*
!directus/uploads/.gitkeep

# Ignore ad-hoc dumps; track only our custom endpoint source + built bundle
directus/extensions/*
!directus/extensions/.gitkeep
!directus/extensions/analista-comercial/
!directus/extensions/analista-comercial/**

# Re-ignore deps (the `!**` above would otherwise re-include node_modules)
directus/extensions/analista-comercial/node_modules/

# Keep built bundle for Docker mount (global `dist` rule would hide it)
!directus/extensions/analista-comercial/dist/
!directus/extensions/analista-comercial/dist/**

directus/snapshots/*.yaml
directus/snapshots/*.yml
!directus/snapshots/.gitkeep
