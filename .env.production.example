# Production deploy env — used by ./scripts/deploy.sh FROM YOUR LAPTOP
# Copy:  cp .env.production.example .env.production
# Then:  ./scripts/deploy.sh --env-file .env.production

# --- VPS connection ---
# SSH target (user@host). Key-based auth required (BatchMode).
DEPLOY_SSH=root@YOUR_VPS_IP
# Path to your .pem / private key on THIS machine (laptop)
DEPLOY_SSH_KEY=~/.ssh/your-key.pem
# Absolute path on the VPS where the project will live
DEPLOY_PATH=/opt/ipanema_crm

# --- Directus ---
# Public API URL (reverse proxy + TLS on the VPS points here → DIRECTUS_PORT)
PUBLIC_URL=https://api.REPLACE_WITH_DOMAIN
VITE_DIRECTUS_URL=https://api.REPLACE_WITH_DOMAIN
VITE_USE_MOCK=false
# Static token with write access for XLSX → Directus sync
# Directus Admin → Settings → Access Tokens
VITE_DIRECTUS_TOKEN=
DIRECTUS_PORT=8083
# Frontend origin(s), e.g. https://crm.REPLACE_WITH_DOMAIN (true = any origin)
CORS_ORIGIN=true

# Generate with: openssl rand -hex 32
DIRECTUS_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

ADMIN_EMAIL=admin@soultech.solutions
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- Frontend (./scripts/deploy.sh --frontend) ---
# Folder served by the web server under /ipanema_crm2/ (FRONTEND_SSH defaults to DEPLOY_SSH)
FRONTEND_PATH=/www/wwwroot/REPLACE_WITH_SITE/ipanema_crm2
FRONTEND_OWNER=www:www

# --- Postgres ---
# true  = run Postgres inside Compose on the VPS (DB_HOST/DB_PORT ignored)
# false = use an existing Postgres; from inside Docker the host machine is
#         usually DB_HOST=host.docker.internal
DEPLOY_LOCAL_DB=false
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=REPLACE_WITH_DB_USER
# Use single quotes if the password has # ! @ $ & etc.
DB_PASSWORD='REPLACE_WITH_DB_PASSWORD'
DB_DATABASE=REPLACE_WITH_DB_NAME

# --- Analista Comercial (Claude) ---
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=2048
ANALISTA_MAX_TOOL_ROUNDS=6
ANALISTA_ENABLED=true

# --- Email → Oportunidades ---
EMAIL_INGEST_ENABLED=true
# imap | o365
MAIL_PROVIDER=o365
MAIL_POLL_CRON='*/2 * * * *'
MAIL_BATCH_SIZE=20
MAIL_PROCESSED_FOLDER=CRM-Processados
EMAIL_MAX_ATTACHMENTS=5
EMAIL_MAX_ATTACHMENT_MB=10
EMAIL_PRICE_MARKUP_PCT=40
EMAIL_EXTRACTOR_MODEL=
EMAIL_EXTRACTOR_MAX_TOKENS=4096
EMAIL_EXTRACTOR_MAX_TOOL_ROUNDS=10

IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

O365_TENANT_ID=REPLACE_WITH_TENANT_ID
O365_CLIENT_ID=REPLACE_WITH_APP_CLIENT_ID
O365_CLIENT_SECRET='REPLACE_WITH_APP_SECRET'
O365_MAILBOX=comercial@empresa.com.br
O365_FOLDER=inbox
