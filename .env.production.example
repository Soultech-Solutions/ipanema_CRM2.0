# Production env for api-raca-comercial.soultech.solutions
# Copy to .env on the server:  cp .env.production.example .env

# Frontend (if built separately — point at this API)
VITE_DIRECTUS_URL=https://api-raca-comercial.soultech.solutions
VITE_USE_MOCK=false

# Directus public URL (must match the TLS hostname)
PUBLIC_URL=https://api-raca-comercial.soultech.solutions
DIRECTUS_PORT=8055

# Comma-separated origins, or "true" to allow all
CORS_ORIGIN=true

# Generate with: openssl rand -hex 32
DIRECTUS_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

ADMIN_EMAIL=admin@soultech.solutions
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Existing VPS PostgreSQL (no Compose Postgres is started in production)
# If Postgres runs on the same VPS host:
#   DB_HOST=host.docker.internal
# If Postgres is elsewhere / another container hostname / IP:
#   DB_HOST=10.0.0.5
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_DATABASE=REPLACE_WITH_DB_NAME
