# Production env for api-raca-comercial.soultech.solutions
# Copy to .env on the server:  cp .env.production.example .env

# Frontend (if built separately — point at this API)
VITE_DIRECTUS_URL=https://api-raca-comercial.soultech.solutions
VITE_USE_MOCK=false

# Directus public URL (must match the TLS hostname)
PUBLIC_URL=https://api-raca-comercial.soultech.solutions
DIRECTUS_PORT=8055

# Comma-separated origins, or "true" to allow all (dev only)
CORS_ORIGIN=true

# Generate with: openssl rand -hex 32
DIRECTUS_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

ADMIN_EMAIL=admin@soultech.solutions
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

DB_USER=directus
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_DATABASE=directus
