# Frontend (Vite)
VITE_DIRECTUS_URL=http://localhost:8055
VITE_USE_MOCK=true
# Static token with write access (required when VITE_USE_MOCK=false for XLSX sync)
# Create in Directus Admin → Settings → Access Tokens
VITE_DIRECTUS_TOKEN=

# Docker Compose / Directus
DIRECTUS_PORT=8055
FRONTEND_PORT=3000
PUBLIC_URL=http://localhost:8055
CORS_ORIGIN=http://localhost:3000

# Generate with: openssl rand -hex 32
DIRECTUS_SECRET=change-me-to-a-long-random-secret

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

DB_USER=directus
DB_PASSWORD=directus
DB_DATABASE=directus
# Local Compose Postgres service name (use --profile local-db)
DB_HOST=database
DB_PORT=5432

# Analista Comercial (Directus extension → Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=2048
ANALISTA_MAX_TOOL_ROUNDS=6
ANALISTA_ENABLED=true

# Email → Oportunidades (extension email-oportunidades)
# Liga a leitura automática (cron). O botão "Sincronizar agora" funciona mesmo com false.
EMAIL_INGEST_ENABLED=false
# imap | o365
MAIL_PROVIDER=imap
MAIL_POLL_CRON='*/2 * * * *'
MAIL_BATCH_SIZE=20
# Pasta para onde os emails processados são movidos (vazio = só marca como lido)
MAIL_PROCESSED_FOLDER=CRM-Processados
EMAIL_MAX_ATTACHMENTS=5
EMAIL_MAX_ATTACHMENT_MB=10
# Opcional: modelo/limites só para a extração (padrão: ANTHROPIC_MODEL)
EMAIL_EXTRACTOR_MODEL=
EMAIL_EXTRACTOR_MAX_TOKENS=4096
EMAIL_EXTRACTOR_MAX_TOOL_ROUNDS=10

# IMAP genérico (Gmail: use senha de app; Locaweb/HostGator: dados do painel)
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Office 365 (Microsoft Graph, client credentials — permissão de aplicação Mail.ReadWrite)
O365_TENANT_ID=
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_MAILBOX=
O365_FOLDER=inbox
