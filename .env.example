# Frontend (Vite)
VITE_DIRECTUS_URL=http://localhost:8055
VITE_USE_MOCK=true
# Static token with write access (required when VITE_USE_MOCK=false for XLSX sync)
# Create in Directus Admin → Settings → Access Tokens
VITE_DIRECTUS_TOKEN=

# Docker Compose / Directus
DIRECTUS_PORT=8055
FRONTEND_PORT=3000
PUBLIC_URL=http://localhost:8055
CORS_ORIGIN=http://localhost:3000

# Generate with: openssl rand -hex 32
DIRECTUS_SECRET=change-me-to-a-long-random-secret

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

DB_USER=directus
DB_PASSWORD=directus
DB_DATABASE=directus
# Local Compose Postgres service name (use --profile local-db)
DB_HOST=database
DB_PORT=5432

# Analista Comercial (Directus extension → Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=2048
ANALISTA_MAX_TOOL_ROUNDS=6
ANALISTA_ENABLED=true
