{
  "name": "raca_analista_comercial",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "docker:up": "docker compose --profile local-db up -d --build",
    "docker:down": "docker compose --profile local-db down",
    "docker:logs": "docker compose logs -f",
    "docker:backend": "docker compose --profile local-db up -d database cache directus",
    "directus:bootstrap": "node scripts/bootstrap-directus.mjs",
    "extension:install": "npm --prefix directus/extensions/analista-comercial install",
    "extension:build": "npm --prefix directus/extensions/analista-comercial run build",
    "seed:analytics": "vite-node scripts/build-analytics-seed.ts",
    "directus:snapshot": "docker compose exec directus npx directus schema snapshot ./snapshots/snapshot.yaml",
    "deploy": "bash scripts/deploy.sh --env-file .env.production",
    "deploy:bootstrap": "bash scripts/deploy.sh --env-file .env.production --bootstrap"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@mdi/font": "7.4.47",
    "axios": "^1.18.1",
    "pinia": "^4.0.2",
    "vue": "^3.5.30",
    "vue-router": "^4.6.4",
    "vuetify": "^4.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "@vuetify/mcp": "^0.5.0",
    "eslint": "^9.39.4",
    "eslint-config-vuetify": "^4.3.4",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.98.0",
    "typescript": "~5.9.3",
    "unplugin-fonts": "^2.0.0",
    "vite": "^8.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.2.5"
  }
}
